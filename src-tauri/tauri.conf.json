{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neko",
  "mainBinaryName": "Neko",
  "version": "0.1.0",
  "identifier": "io.github.feitangyuan.neko",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Neko",
        "label": "main",
        "width": 1240,
        "height": 840,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "center": true,
        "backgroundColor": "#e8e8e2",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "externalBin": [
      "binaries/dsh-node"
    ],
    "resources": [
      "resources/dsh-version.txt",
      "runtime/dsh",
      "runtime/pnpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
